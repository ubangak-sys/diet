# Скопируйте этот файл в .env.local и подставьте значения из Supabase.
# Эти переменные публичные (встраиваются в статическую сборку) — это нормально,
# т.к. anon-key не даёт доступа к защищённым данным (работает RLS).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
